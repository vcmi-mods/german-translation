[
    {
        "timeStart": 2.28,
        "timeEnd": 6.77,
        "text": "Unsterblich zu sein hat einen Nachteil: Man wird einsam."
    },
    {
        "timeStart": 8.59,
        "timeEnd": 10.51,
        "text": "Doch bei den Drachen, die in der Regel"
    },
    {
        "timeStart": 10.51,
        "timeEnd": 13.574,
        "text": "sehr alt werden, fand Tarnum gute Freunde."
    },
    {
        "timeStart": 13.574,
        "timeEnd": 15.798,
        "text": "Und die Art, wie sie jeden Tag ihres"
    },
    {
        "timeStart": 15.798,
        "timeEnd": 18.77,
        "text": "Lebens genießen, erfüllte auch ihn mit Freude."
    },
    {
        "timeStart": 22.71,
        "timeEnd": 25.406,
        "text": "Dann, eines trüben Morgens, verschwanden"
    },
    {
        "timeStart": 25.406,
        "timeEnd": 27.09,
        "text": "die Drachen ohne ein Wort."
    },
    {
        "timeStart": 30.59,
        "timeEnd": 32.858,
        "text": "Nun musste Tarnum herausfinden,"
    },
    {
        "timeStart": 32.858,
